__pycache__/
*.pyc
.venv/

# Datensaetze, Modelle, Checkpoints, Zwischendateien -- gross und/oder
# in Sekunden aus Skripten neu erzeugbar, gehoeren nicht ins Repo.
# Python-CODE unter daten/ (z.B. vortokenisiere.py) ist davon ausdruecklich
# AUSGENOMMEN -- die Endungs-Ausnahme unten holt ihn zurueck.
#
# tokenizer.pkl ist ebenfalls ausgenommen: er ist KEIN aus dem Code neu
# erzeugbares Zwischenprodukt (kein Skript im Repo trainiert ihn), sondern
# die eine feste Tokenisierung, mit der der gesamte 384,8-Mio.-Token-Korpus
# bereits erzeugt wurde -- ohne ihn im Repo bricht jeder frische Clone
# (z.B. Colab) an genau dieser Stelle ab. Klein genug fuers Repo (~87 KB).
daten/*
!daten/*.py
!daten/tokenizer.pkl
daten/roh/
modelle/
*.pt
*.ckpt
*.bin
*.parquet

# Testartefakte, die Skripte selbst anlegen und wieder loeschen sollten,
# aber zur Sicherheit auch hier ausgeschlossen
_evaltest/
bewertung/_wegwerf_n8n_db/
kern/_test_checkpoint_lauf/
kern/_trainingslauf_fuer_test.py
